# Environment Configuration Template
# Copy this to .env and update with your values

# Flask Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
# For SQLite (development):
# DATABASE_URL=sqlite:///attendance_system.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/attendance_system

# Face Recognition Settings
RECOGNITION_THRESHOLD=0.55
COOLDOWN_SECONDS=10
ATTENDANCE_ALERT_THRESHOLD=75

# Flask Settings
FLASK_DEBUG=True
# FLASK_DEBUG=False (for production)

# AI Chatbot Configuration
# Supported providers: gemini, openai, groq, openai_compatible
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-3.6-flash
# Optional: custom base URL for OpenAI-compatible or local endpoints (e.g., https://api.groq.com/openai/v1 or http://localhost:11434/v1)
AI_BASE_URL=
# Chat rate limit (requests per minute per user)
CHAT_RATE_LIMIT=30
AI_TIMEOUT_SECONDS=30
